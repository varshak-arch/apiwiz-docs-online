---
// Desktop: topic switching lives in the header tabs, so the sidebar shows only the current topic's pages.
// Mobile: the header tabs are hidden, so the topic list is shown at the top of the slide-out menu.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import TopicTabs from './TopicTabs.astro';

const isPageWithTopic = Astro.locals.starlightSidebarTopics?.isPageWithTopic;
const current = Astro.locals.starlightSidebarTopics?.topics?.find((t) => t.isCurrent);
---

{isPageWithTopic && <div class="mobile-topics md:sl-hidden"><TopicTabs /></div>}
{current && <p class="sidebar-heading">{current.label}</p>}
<Default />

<style>
  .sidebar-heading {
    margin: 0.25rem 0 0.6rem;
    padding-inline: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .mobile-topics {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .mobile-topics :global(ul) {
    flex-direction: column;
    -webkit-mask-image: none;
    mask-image: none;
    gap: 0;
  }
  .mobile-topics :global(a) {
    border-radius: 0.4rem;
    padding: 0.55rem 0.6rem;
  }
  .mobile-topics :global(a[aria-current='page']) {
    background: var(--sl-color-accent-low);
  }
  .mobile-topics :global(a[aria-current='page']::after) {
    display: none;
  }
</style>
