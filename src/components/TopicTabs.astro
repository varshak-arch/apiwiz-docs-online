---
import { Icon } from '@astrojs/starlight/components';

const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
---

<nav class="topic-tabs" aria-label="Documentation sections">
  <ul>
    {
      topics.map((topic) => (
        <li>
          <a href={topic.link} aria-current={topic.isCurrent ? 'page' : undefined}>
            {topic.icon && <Icon name={topic.icon} size="1rem" />}
            <span>{topic.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .topic-tabs ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topic-tabs a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 0.75rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    border-radius: 0.4rem 0.4rem 0 0;
    transition: color 120ms ease;
  }
  .topic-tabs a:hover {
    color: var(--sl-color-white);
  }
  .topic-tabs a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  .topic-tabs a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--sl-color-accent);
  }
  .topic-tabs a[aria-current='page'] :global(svg) {
    color: var(--sl-color-accent);
  }
</style>
