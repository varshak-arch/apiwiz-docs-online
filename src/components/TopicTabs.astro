---
import { Icon } from '@astrojs/starlight/components';

const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
---

<topic-tabs class="topic-tabs">
  <nav aria-label="Documentation categories">
    <ul>
      {
        topics.map((topic) => (
          <li>
            <a href={topic.link} aria-current={topic.isCurrent ? 'page' : undefined}>
              {topic.icon && <Icon name={topic.icon} size="0.95rem" />}
              <span>{topic.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</topic-tabs>

<script>
  // Keep the active tab visible, and fade the edges only when there is more to scroll to.
  class TopicTabs extends HTMLElement {
    connectedCallback() {
      const list = this.querySelector('ul');
      if (!list) return;
      const update = () => {
        this.toggleAttribute('data-more-start', list.scrollLeft > 4);
        this.toggleAttribute('data-more-end', list.scrollLeft + list.clientWidth < list.scrollWidth - 4);
      };
      const current = list.querySelector<HTMLElement>('[aria-current="page"]');
      if (current && list.scrollWidth > list.clientWidth) {
        list.scrollLeft = current.parentElement!.offsetLeft - list.clientWidth / 2 + current.offsetWidth / 2;
      }
      list.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(list);
      update();
    }
  }
  customElements.define('topic-tabs', TopicTabs);
</script>

<style>
  topic-tabs {
    display: block;
    min-width: 0;
    width: 100%;
    --fade-start: 0;
    --fade-end: 0;
  }
  topic-tabs[data-more-start] {
    --fade-start: 2.5rem;
  }
  topic-tabs[data-more-end] {
    --fade-end: 2.5rem;
  }
  ul {
    display: flex;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--fade-start), #000 calc(100% - var(--fade-end)), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 var(--fade-start), #000 calc(100% - var(--fade-end)), transparent);
  }
  ul::-webkit-scrollbar {
    display: none;
  }
  a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.48rem;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 120ms ease;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  a[aria-current='page'] {
    color: var(--sl-color-white);
    font-weight: 600;
  }
  a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset-inline: 0.48rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--apiwiz-gradient);
  }
  /* Icons only when there is room for every tab */
  @media (max-width: 110rem) {
    a :global(svg) {
      display: none;
    }
  }
  a[aria-current='page'] :global(svg) {
    color: var(--sl-color-accent);
  }
</style>
