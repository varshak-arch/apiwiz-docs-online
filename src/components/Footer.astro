---
import Default from '@astrojs/starlight/components/Footer.astro';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const issueUrl = `https://github.com/varshak-arch/apiwiz-docs-online/issues/new?title=${encodeURIComponent(
  `Docs feedback: ${entry.data.title}`
)}&body=${encodeURIComponent(`Page: ${Astro.url.pathname}\n\nWhat was missing or unclear?\n`)}`;
---

{
  !isSplash && (
    <page-feedback class="feedback print:hidden">
      <div data-ask>
        <span>Was this page helpful?</span>
        <button type="button" data-vote="yes">Yes</button>
        <button type="button" data-vote="no">No</button>
      </div>
      <p data-thanks hidden>Thanks for the feedback.</p>
      <p data-more hidden>
        Sorry about that. <a href={issueUrl} target="_blank" rel="noopener">Tell us what was missing</a>.
      </p>
    </page-feedback>
  )
}
<Default />

<dialog class="lightbox" aria-label="Enlarged image">
  <button type="button" class="lightbox-close" aria-label="Close">✕</button>
  <img alt="" />
</dialog>

<script>
  class PageFeedback extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelector<HTMLElement>('[data-ask]')!.hidden = true;
          const target = b.dataset.vote === 'yes' ? '[data-thanks]' : '[data-more]';
          this.querySelector<HTMLElement>(target)!.hidden = false;
        })
      );
    }
  }
  customElements.define('page-feedback', PageFeedback);

  // Click a screenshot to see it full size.
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const big = dialog?.querySelector('img');
  document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img').forEach((img) => {
    if (img.closest('a')) return;
    img.classList.add('zoomable');
    img.addEventListener('click', () => {
      if (!dialog || !big) return;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', () => dialog.close());
</script>

<style>
  :global(.sl-markdown-content img.zoomable) {
    cursor: zoom-in;
    border-radius: 0.6rem;
    border: 1px solid var(--sl-color-hairline);
  }
  .lightbox {
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: none;
    border-radius: 0.75rem;
    background: transparent;
    overflow: visible;
    cursor: zoom-out;
  }
  .lightbox::backdrop {
    background: rgb(5 8 15 / 0.82);
    backdrop-filter: blur(3px);
  }
  .lightbox img {
    display: block;
    max-width: 96vw;
    max-height: 94vh;
    border-radius: 0.75rem;
    background: #fff;
  }
  .lightbox-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 999px;
    background: rgb(10 14 24 / 0.7);
    color: #fff;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .feedback {
    display: block;
    margin-top: 3rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .feedback [data-ask] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .feedback [data-ask] span {
    margin-inline-end: auto;
  }
  .feedback button {
    font: inherit;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-hairline-shade);
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .feedback button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }
  .feedback p {
    margin: 0;
  }
</style>
